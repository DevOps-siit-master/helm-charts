{
  "title": "ShopHub Platform Logs",
  "uid": "shophub-logs",
  "tags": ["shophub", "logs", "loki"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(namespace)",
        "definition": "label_values(namespace)",
        "current": { "text": "shophub", "value": "shophub" },
        "includeAll": false,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({namespace=\"$namespace\"}, container)",
        "definition": "label_values({namespace=\"$namespace\"}, container)",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "current": { "text": "", "value": "" },
        "query": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Log lines (range)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "expr": "sum(count_over_time({namespace=\"$namespace\", container=~\"$container\"} |~ \"$search\" [$__range]))", "refId": "A" } ]
    },
    {
      "id": 2, "type": "stat", "title": "Errors (range)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "targets": [ { "expr": "sum(count_over_time({namespace=\"$namespace\", container=~\"$container\"} |~ \"(?i)(error|exception|fatal|panic)\" [$__range]))", "refId": "A" } ]
    },
    {
      "id": 3, "type": "stat", "title": "Warnings (range)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" } }, "overrides": [] },
      "targets": [ { "expr": "sum(count_over_time({namespace=\"$namespace\", container=~\"$container\"} |~ \"(?i)(warn|warning)\" [$__range]))", "refId": "A" } ]
    },
    {
      "id": 4, "type": "stat", "title": "Containers logging",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "expr": "count(sum by (container) (count_over_time({namespace=\"$namespace\"} [$__range])))", "refId": "A" } ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Log volume by container",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [ { "expr": "sum by (container) (count_over_time({namespace=\"$namespace\", container=~\"$container\"} |~ \"$search\" [$__auto]))", "legendFormat": "{{container}}", "refId": "A" } ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Errors & warnings over time",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "sum(count_over_time({namespace=\"$namespace\", container=~\"$container\"} |~ \"(?i)(error|exception|fatal|panic)\" [$__auto]))", "legendFormat": "errors", "refId": "A" },
        { "expr": "sum(count_over_time({namespace=\"$namespace\", container=~\"$container\"} |~ \"(?i)(warn|warning)\" [$__auto]))", "legendFormat": "warnings", "refId": "B" }
      ]
    },
    {
      "id": 7, "type": "logs", "title": "Live logs",
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "showLabels": false, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [ { "expr": "{namespace=\"$namespace\", container=~\"$container\"} |~ \"$search\"", "refId": "A" } ]
    },
    {
      "id": 8, "type": "logs", "title": "Errors only",
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [ { "expr": "{namespace=\"$namespace\", container=~\"$container\"} |~ \"(?i)(error|exception|fatal|panic)\"", "refId": "A" } ]
    }
  ]
}
